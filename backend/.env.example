NODE_ENV=development
APP_PORT=3001

DB_DIALECT=mysql
DB_HOST=localhost
DB_NAME=aigc_platform
DB_USER=root
DB_PASSWORD=your_db_password
DB_PORT=3306

JWT_ACCESS_SECRET=your-access-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars

# SMS Service（短信服务配置）
SMS_API_URL=https://sms.example.com/api
SMS_API_KEY=your-sms-api-key
SMS_SIGN_NAME=your-sign-name

# 易支付配置
EPAY_API_URL=https://pay.example.com
EPAY_MERCHANT_ID=your-merchant-id
EPAY_MERCHANT_KEY=your-merchant-key

# 文件上传
UPLOAD_DIR=./uploads
# 应用对外访问的根 URL，用于拼接上传图片的在线地址
# 生产环境改为实际域名，例如 https://api.yourdomain.com
BASE_URL=http://localhost:3001

# 支付FM 易支付配置
ZFMFM_API_URL=https://api.zhifux.com
ZFMFM_MERCHANT_NUM=your-zhifufm-merchant-num
ZFMFM_API_KEY=your-zhifufm-api-key
